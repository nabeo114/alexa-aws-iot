aws_region           = "ap-northeast-1"
project_name         = "alexa-aws-iot"
environment          = "prod"
default_tags         = {}

lambda_function_name = "alexa-aws-iot"
lambda_role_name     = "alexa-aws-iot-role"
lambda_runtime       = "python3.12"
lambda_handler       = "src.lambda_handler.lambda_handler"
lambda_timeout       = 10
lambda_memory_size   = 128

dynamodb_table_name     = "line-bot-env"
dynamodb_partition_key  = "client_id"
dynamodb_partition_name = "ESP32Client-0000"

lambda_zip_path = "../../dist/alexa-aws-iot-lambda.zip"

alexa_skill_id = ""
